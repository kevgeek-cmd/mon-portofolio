generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum PostStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
}

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  passwordHash  String
  name          String
  role          Role       @default(ADMIN)
  avatar        String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  posts         BlogPost[]

  @@map("users")
}

model ProjectCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  projects    Project[]

  @@map("project_categories")
}

model Project {
  id            String          @id @default(uuid())
  title         String
  slug          String          @unique
  summary       String
  description   String          @db.Text
  coverImage    String
  images        String[]
  liveUrl       String?
  githubUrl     String?
  technologies  String[]
  isFeatured    Boolean         @default(false)
  order         Int             @default(0)
  categoryId    String?
  category      ProjectCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@map("projects")
}

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  slug        String     @unique
  description String?
  posts       BlogPost[]

  @@map("categories")
}

model Tag {
  id        String          @id @default(uuid())
  name      String          @unique
  slug      String          @unique
  posts     PostTag[]

  @@map("tags")
}

model BlogPost {
  id             String      @id @default(uuid())
  title          String
  slug           String      @unique
  excerpt        String      @db.Text
  content        String      @db.Text
  featuredImage  String
  galleryImages  String[]
  status         PostStatus  @default(PUBLISHED)
  publishedAt    DateTime?   @default(now())
  readingTime    Int         @default(5)
  authorId       String?
  author         User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName     String?     @default("Équipe Rédaction")
  authorAvatar   String?
  categoryId     String?
  category       Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  allowComments  Boolean     @default(true)
  seoTitle       String?
  seoDescription String?     @db.Text
  views          Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  tags           PostTag[]
  comments       Comment[]

  @@map("blog_posts")
}

model PostTag {
  postId String
  tagId  String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("post_tags")
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  name      String
  email     String
  content   String   @db.Text
  isApproved Boolean @default(true)
  createdAt DateTime @default(now())

  @@map("comments")
}

model Testimonial {
  id         String   @id @default(uuid())
  clientName String
  role       String
  company    String
  avatar     String?
  quote      String   @db.Text
  rating     Int      @default(5)
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  @@map("testimonials")
}

model Service {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String   @db.Text
  icon        String
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@map("services")
}

model Faq {
  id        String   @id @default(uuid())
  question  String
  answer    String   @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("faq")
}

model Gallery {
  id          String         @id @default(uuid())
  title       String
  slug        String         @unique
  category    String         @default("Général")
  description String?
  images      GalleryImage[]
  createdAt   DateTime       @default(now())

  @@map("galleries")
}

model GalleryImage {
  id        String   @id @default(uuid())
  galleryId String
  gallery   Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  imageUrl  String
  title     String?
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("gallery_images")
}

model YoutubeVideo {
  id          String   @id @default(uuid())
  title       String
  youtubeId   String
  description String?
  isPlaylist  Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@map("youtube_videos")
}

model YoutubePlaylist {
  id          String   @id @default(uuid())
  title       String
  playlistId  String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@map("youtube_playlists")
}

model SocialLink {
  id        String   @id @default(uuid())
  platform  String   @unique // Facebook, LinkedIn, Instagram, TikTok, YouTube, GitHub
  url       String
  icon      String
  isActive  Boolean  @default(true)
  order     Int      @default(0)

  @@map("social_links")
}

model ContactMessage {
  id        String   @id @default(uuid())
  fullName  String
  company   String?
  phone     String?
  email     String
  subject   String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contacts")
}

model NewsletterSubscriber {
  id           String   @id @default(uuid())
  email        String   @unique
  subscribedAt DateTime @default(now())
  isActive     Boolean  @default(true)

  @@map("newsletters")
}

model Media {
  id        String   @id @default(uuid())
  filename  String
  url       String
  publicId  String?
  format    String?
  size      Int?
  createdAt DateTime @default(now())

  @@map("media")
}

model Settings {
  id             String   @id @default("default")
  // Branding
  companyName    String   @default("VOTRE ENTREPRISE")
  companySubtitle String  @default("AGENCE DIGITALE")
  companyLogoUrl String?

  // Header
  headerCtaText  String   @default("Parlons de votre projet ↗")
  headerCtaLink  String   @default("#contact")

  // Hero Section
  heroBadgeText  String   @default("Disponible pour de nouveaux projets")
  heroTitle      String   @default("Je transforme des idées en expériences digitales")
  heroSubtitle   String   @default("Référent digital polyvalent, j'accompagne les marques dans leur croissance...")
  heroSkills     String   @default("Communication, Design, IA, Développement, Vidéo, Photo")
  heroVideoUrl   String   @default("")
  heroCtaText    String   @default("Découvrir mon travail")
  heroCtaLink    String   @default("#projets")
  heroSecondaryCtaText String @default("Me contacter")
  heroSecondaryCtaLink String @default("#contact")
  heroImageMain       String?
  heroWidget1Icon     String  @default("🎬")
  heroWidget1Title    String  @default("Montage Vidéo")
  heroWidget1Subtitle String  @default("Premiere Pro, After Effects")
  heroWidget2Title    String  @default("Croissance")
  heroWidget2Value    String  @default("+125%")
  heroWidget2Subtitle String  @default("Engagement")
  heroFloatingIcon1   String?
  heroFloatingIcon2   String?
  heroFloatingIcon3   String?

  // About Section
  aboutBadge     String   @default("À PROPOS DE NOUS →")
  aboutTitle     String   @default("L'innovation et la performance au service de vos ambitions")
  aboutMainText  String   @default("Nous sommes une équipe d'experts dédiée à la conception d'outils numériques performants, modernes et sur mesure.")
  aboutSubText   String   @default("Notre mission est d'accompagner les entreprises et entrepreneurs dans leur croissance grâce à des technologies de pointe et un design d'exception.")
  aboutLocation1 String   @default("Basé en Côte d'Ivoire")
  aboutLocation2 String   @default("Disponible à distance")
  aboutCtaText   String   @default("En savoir plus sur mon parcours")
  aboutCtaLink   String   @default("#")
  aboutImageUrl  String   @default("https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=1200&q=80")
  aboutBadgeStat String   @default("100%")
  aboutBadgeLabel String  @default("Excellence | Savoir-faire")
  aboutExperienceText String @default("d'expérience dans le digital")

  // Stats Section
  statProjects    Int     @default(30)
  statLabelProjects String @default("Projets réalisés")
  statClients     Int     @default(15)
  statLabelClients String @default("Clients satisfaits")
  statExperience  Int     @default(3)
  statLabelExperience String @default("Années d'expérience")
  statPassion     Int     @default(100)
  statLabelPassion String @default("Passion & Engagement")

  // About 4 Values
  aboutValue1Icon  String @default("Lightbulb")
  aboutValue1Title String @default("Créativité")
  aboutValue1Desc  String @default("Des idées uniques et percutantes.")
  aboutValue2Icon  String @default("Wrench")
  aboutValue2Title String @default("Polyvalence")
  aboutValue2Desc  String @default("Une expertise multi-compétences.")
  aboutValue3Icon  String @default("TrendingUp")
  aboutValue3Title String @default("Résultats")
  aboutValue3Desc  String @default("Des solutions orientées impact.")
  aboutValue4Icon  String @default("Sparkles")
  aboutValue4Title String @default("Innovation")
  aboutValue4Desc  String @default("IA & nouvelles technologies.")

  // Expertise & Projects & Tools
  expertiseSectionTitle String @default("Mes domaines d'expertise")
  projectsSectionTitle  String @default("Mes projets récents")
  projectsCtaText       String @default("Voir tous les projets")
  toolsSectionTitle     String @default("Outils & Technologies")
  toolsSectionSubtitle  String @default("Mon stack technique pour créer des expériences remarquables")

  // Contact & Address
  contactTitle   String   @default("Vous avez un projet ? Parlons-en !")
  contactSubtitle String  @default("Je suis disponible pour de nouvelles opportunités et la création de vos prochains produits digitaux.")
  contactPrimaryBtnText String @default("Me contacter")
  contactSecondaryBtnText String @default("Voir mes services")
  contactWhatsappBtnText String @default("Discutons sur WhatsApp")
  contactWhatsappUrl String @default("https://wa.me/2250000000000")
  
  companyEmail   String   @default("contact@votre-entreprise.com")
  companyPhone   String   @default("+33 1 23 45 67 89")
  companyAddress String   @default("Paris, France")
  mapEmbedUrl    String?  @default("")

  // Footer & General
  footerTagline  String   @default("Concepteur de solutions digitales d'excellence.")
  copyrightText  String   @default("© 2026 Votre Entreprise. Tous droits réservés.")

  // Colors & Theme
  primaryColor   String   @default("#D4AF37")
  darkBgColor    String   @default("#0B0B0C")
  beigeBgColor   String   @default("#F7F5F0")

  // Menu Items (JSON string or object)
  menuItems      Json?

  updatedAt      DateTime @updatedAt

  @@map("settings")
}

model SeoSettings {
  id             String   @id @default("default")
  siteTitle      String   @default("Template Landing Page | Agence Digitale")
  siteDescription String  @default("Solutions numériques modernes et performantes conçues pour booster votre visibilité.")
  ogImage        String?
  keywords       String[]
  twitterHandle  String?  @default("@agence_digitale")
  updatedAt      DateTime @updatedAt

  @@map("seo_settings")
}

model Tool {
  id        String   @id @default(uuid())
  name      String
  iconUrl   String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tools")
}

model ManagedPage {
  id          String   @id @default(uuid())
  name        String
  platform    String
  url         String?
  imageUrl    String
  stats       String?
  description String?  @db.Text
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("managed_pages")
}
